# Solo Docker Compose. Copiar como .env (propietario redclubes, chmod 600).
# Completar ANTES de desplegar; ningun valor secreto se genera en Git.
MYSQL_DATABASE=red_clubes
MYSQL_USER=red_clubes_app
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_HEX
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
PUBLIC_ORIGIN=https://redclubes.example.com
APP_PORT=8080
# OBLIGATORIO: reemplazar por peer OBSERVADO segun docs/PROXY_Y_RATE_LIMIT.md.
# Fail-closed inicial: no confiar en un gateway supuesto.
TRUSTED_PROXY_CIDR=127.0.0.1/32
DOCKER_SUBNET=172.30.0.0/24
DOCKER_GATEWAY=172.30.0.1
BACKEND_IMAGE=red-clubes-backend
FRONTEND_IMAGE=red-clubes-frontend
IMAGE_TAG=v0.1.0-pilot
AUTH_SESSION_HOURS=8
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_BLOCK_MINUTES=15
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_VALIDATION_TIMEOUT_MS=3000
DB_POOL_MAX_LIFETIME_MS=1800000
DEMO_DATA_ENABLED=false
PUBLIC_ENROLLMENT_ENABLED=false
PUBLIC_ENROLLMENT_CLUB_ID=0
PUBLIC_ENROLLMENT_SLUG=bomberos-ensenada
# Reemplazar por el dominio HTTPS de la web pública antes de habilitar.
PUBLIC_FORM_ORIGINS=https://bomberos.example.com
BOOTSTRAP_SUPERUSER_ENABLED=false
BOOTSTRAP_SUPERUSER_NAME=Administrador
BOOTSTRAP_SUPERUSER_LASTNAME=Piloto
# Agregar DNI/PASSWORD SOLO en aprovisionamiento; luego eliminar esas lineas.
# BOOTSTRAP_SUPERUSER_DNI=9900000000
# BOOTSTRAP_SUPERUSER_PASSWORD=
# Compose deriva DB_URL/DB_USERNAME/DB_PASSWORD de MYSQL_*.
# Fuerza perfil prod, Flyway=true, baseline=false: no duplicar esas variables.
# BACKUP_* va en /etc/red-clubes/backup.env, consumido por systemd o exportado.
