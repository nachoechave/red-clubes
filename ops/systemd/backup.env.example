# /etc/red-clubes/backup.env: root:redclubes, 0640. No passwords DB aqui.
# Sintaxis KEY=value sin expansion $VAR; compatible con EnvironmentFile.
BACKUP_DIR=/var/backups/red-clubes
BACKUP_RETENTION_DAYS=14
BACKUP_EXPORT_HOOK=/opt/red-clubes/ops/backup-export-age.sh
BACKUP_AGE_RECIPIENT=REPLACE_WITH_PUBLIC_AGE_RECIPIENT
BACKUP_COPY_DIR=/mnt/red-clubes-offsite
