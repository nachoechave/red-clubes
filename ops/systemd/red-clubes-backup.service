[Unit]
Description=Red Clubes backup cifrado y copia externa
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/red-clubes-offsite
OnFailure=red-clubes-backup-failure.service

[Service]
Type=oneshot
User=redclubes
Group=redclubes
SupplementaryGroups=docker
WorkingDirectory=/opt/red-clubes
EnvironmentFile=/etc/red-clubes/backup.env
UMask=0077
ExecStart=/usr/bin/sh /opt/red-clubes/ops/backup-mysql.sh
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
