# Backend
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/red_clubes?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Argentina/Buenos_Aires
DB_USERNAME=red_clubes_app
DB_PASSWORD=change_me
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_VALIDATION_TIMEOUT_MS=3000
DB_POOL_MAX_LIFETIME_MS=1800000
JPA_SHOW_SQL=false
FLYWAY_ENABLED=true
# Solo para adoptar una base preexistente sin flyway_schema_history. Usar una vez, despues volver a false.
FLYWAY_BASELINE_ON_MIGRATE=false
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
AUTH_SESSION_HOURS=8
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_BLOCK_MINUTES=15
# Carga clubes y datos de muestra, pero nunca crea usuarios ni credenciales.
DEMO_DATA_ENABLED=false

# Creacion inicial opcional. Habilitar solo durante el aprovisionamiento.
BOOTSTRAP_SUPERUSER_ENABLED=false
BOOTSTRAP_SUPERUSER_DNI=change_me
BOOTSTRAP_SUPERUSER_PASSWORD=change_me
BOOTSTRAP_SUPERUSER_NAME=Administrador
BOOTSTRAP_SUPERUSER_LASTNAME=Inicial

# Docker Compose / piloto cloud
MYSQL_DATABASE=red_clubes
MYSQL_USER=red_clubes_app
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_too
PUBLIC_ORIGIN=http://localhost:8080
APP_PORT=8080
TRUSTED_PROXY_CIDR=172.30.0.1/32
DOCKER_SUBNET=172.30.0.0/24
DOCKER_GATEWAY=172.30.0.1

# Versionado de imagenes. En releases usar un tag inmutable (por ejemplo v1.2.0), nunca latest.
BACKEND_IMAGE=red-clubes-backend
FRONTEND_IMAGE=red-clubes-frontend
IMAGE_TAG=local

# Operacion de backups
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Ruta opcional a un hook shell propio. Recibe el backup verificado como unico argumento.
BACKUP_EXPORT_HOOK=
# Variables consumidas por ops/backup-export-hook.example.sh (opcionales).
BACKUP_AGE_RECIPIENT=
BACKUP_COPY_DIR=
